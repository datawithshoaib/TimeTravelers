# TimeTravelers Environment Configuration

DATABASE_URL=sqlite:///./timetravelers.db
VECTOR_STORE_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=timetravelers-sources
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# LLM drafting: auto | anthropic | offline. "auto" uses Claude when ANTHROPIC_API_KEY is set.
LLM_MODE=auto
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
EMBEDDING_API_KEY=
REDIS_URL=redis://localhost:6379/0
AUTH_SECRET=development-secret-key-32-chars-long-minimum
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Next.js frontend: where the server-side rewrite proxies /api/* and /health/*
API_INTERNAL_URL=http://localhost:8000
